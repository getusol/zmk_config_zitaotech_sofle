 * 定制键图 —— 设计记录见 keymap-design/
 * Caps->Esc / 位置0=`~` / HRM(A S D F + J K L ;) / 60=导航层 / 61=符号层(兼小红点滚轮) / MOUSE层自动
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define FUNC 1
#define RES 2
#define BOT bootloader

/ {
    input_processors {
        zip_temp_layer: zip_temp_layer {
            compatible = "zmk,input-processor-temp-layer";
            #input-processor-cells = <2>;
        };
        ip_behaviors0: ip_behaviors0 { compatible = "zmk,input-processor-behaviors"; #input-processor-cells = <0>; type = <INPUT_EV_KEY>; codes = <INPUT_BTN_0>; bindings = <&kp RIGHT>; };
        ip_behaviors1: ip_behaviors1 { compatible = "zmk,input-processor-behaviors"; #input-processor-cells = <0>; type = <INPUT_EV_KEY>; codes = <INPUT_BTN_1>; bindings = <&kp LEFT>; };
        ip_behaviors2: ip_behaviors2 { compatible = "zmk,input-processor-behaviors"; #input-processor-cells = <0>; type = <INPUT_EV_KEY>; codes = <INPUT_BTN_2>; bindings = <&kp DOWN>; };
        ip_behaviors3: ip_behaviors3 { compatible = "zmk,input-processor-behaviors"; #input-processor-cells = <0>; type = <INPUT_EV_KEY>; codes = <INPUT_BTN_3>; bindings = <&kp UP>; };
    };
};

/ {
    behaviors {
        /* Home row mods：长按=修饰键、轻点=字母。
         * 位置化触发：左手修饰键只被「右手键 + 两侧拇指」触发，右手反之 → 同手连打不误触
         * 参数取自 urob/zmk-config
         */
        hml: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 20 21 22 23 24 25 33 34 35 36 37 38 39 48 49 50 51 52 53 54 55 61 62 63 64 65>;
            bindings = <&kp &kp>;
        };
        /* 左旋钮按下 LOWER 层时切蓝牙通道用 */
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };

        hmr: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 26 27 28 29 30 31 32 40 41 42 43 44 45 46 47 56 57 58 59 60>;
            bindings = <&kp &kp>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
                &kp GRAVE      &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp C_MUTE     &kp C_MUTE     &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp BSPC
                &kp TAB        &kp Q          &kp W          &kp E          &kp R          &kp T          &kp Y          &kp U          &kp I          &kp O          &kp P          &kp BSLH
                &kp ESC        &hml LGUI A    &hml LALT S    &hml LSHFT D   &hml LCTRL F   &kp G          &mkp LCLK      &mkp LCLK      &kp H          &hmr LCTRL J   &hmr LSHFT K   &hmr LALT L    &hmr LGUI SEMI &kp ENTER
                &kp LSHFT      &kp Z          &kp X          &kp C          &kp V          &kp B          &kp PG_DN      &kp PG_UP      &msc SCRL_DOWN &msc SCRL_UP   &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
                &kp LC(B)      &kp TAB        &kp LANG1       &kp SPACE      &mo 1          &mo 2          &kp BSPC       &kp LGUI       &kp LG(V)      &kp LG(LS(S))
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        lower_layer {
            display-name = "NAV";
            bindings = <
                &kp ESC        &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &bt BT_CLR     &kp C_MUTE     &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp DEL
                &kp TAB        &trans         &trans         &trans         &trans         &out OUT_TOG   &kp F11        &kp F12        &trans         &trans         &trans         &kp BSLH
                &kp CAPS       &trans         &trans         &trans         &trans         &kp HOME       &mkp RCLK      &mkp RCLK      &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT      &kp END        &kp ENTER
                &kp LSHFT      &trans         &trans         &trans         &trans         &rgb_ug RGB_TOG &trans         &trans         &bl BL_DEC     &bl BL_INC     &kp PG_UP      &kp PG_DN      &kp LBKT       &kp RBKT       &kp UNDER      &kp PLUS
                &BOT           &kp LGUI       &trans       &kp SPACE      &mo 1          &mo 2          &kp SPACE      &trans         &kp DOT        &BOT
            >;
            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &kp MINUS      &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp EQUAL
                &kp CARET      &kp AT         &kp HASH       &kp LBKT       &kp LPAR       &kp LBRC       &trans         &trans         &kp RBRC       &kp RPAR       &kp RBKT       &kp PRCNT      &kp DLLR       &trans
                &trans         &kp EXCL       &kp AMPS       &kp ASTRK      &kp LT         &kp TILDE      &trans         &trans         &trans         &trans         &kp UNDER      &kp GT         &kp SQT        &kp DQT        &kp PLUS       &trans
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans         &trans
                &mkp MB5       &trans         &trans         &mkp LCLK      &trans         &trans         &mkp RCLK      &trans         &mkp MCLK      &mkp MB4
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
                &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
                &none          &none          &none          &none          &none          &none          &none          &none          &none          &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };
    };
};
